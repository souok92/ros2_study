<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_interfaces</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="suogi@todo.todo">suogi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!--메시지 생성 도구-->
  <!-- rosidl(interface definition language): msg를 파이썬&cpp로 변환해주는 도구 -->
  <!-- 아래 3줄로 메시지를 생성 -->
  <!-- colcon build할 때 install 폴더 안에 헤더파일 생성한대 -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

   <!-- 사용하는 다른 메시지 패키지 (필요한 경우) -->
   <!-- stdmsg: 표준 메시지 타입 ex)string int32 ... -->
  <depend>std_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
